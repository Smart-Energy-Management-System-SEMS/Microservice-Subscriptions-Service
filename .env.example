# Core runtime
PORT=8080
SERVER_PORT=8080
SERVICE_NAME=subscriptions-service
GIN_MODE=release

# External services
CONFIG_SERVICE_URL=
DATABASE_URL=

# Kafka (Azure/Event Hubs or managed Kafka)
KAFKA_BROKERS=
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=

# Optional timeout
CONFIG_SERVICE_TIMEOUT_MS=3000

# Optional PostgreSQL split variables (if DATABASE_URL is empty)
# POSTGRES_HOST=
# POSTGRES_PORT=5432
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_SSLMODE=require
# POSTGRES_CHANNEL_BINDING=require

# Optional Stripe variables
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional Kafka advanced settings
# KAFKA_ENABLED=true
# KAFKA_BOOTSTRAP_SERVERS=
# KAFKA_CLIENT_ID=subscriptions-service
# KAFKA_CA_CERT_PATH=
# KAFKA_CA_CERT=
# KAFKA_TOPIC_SUBSCRIPTIONS_EVENTS=subscriptions.events
