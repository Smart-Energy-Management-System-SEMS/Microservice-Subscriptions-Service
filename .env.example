SERVER_PORT=8082
SERVICE_NAME=subscriptions-service
CONFIG_SERVICE_URL=http://localhost:8090
CONFIG_SERVICE_TIMEOUT_MS=3000

# Database secrets / deploy-specific values
# Option A: full connection string
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require&channelBinding=require

# Option B: separate PostgreSQL variables (used if DATABASE_URL is empty)
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_DB=your-postgres-db
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_SSLMODE=require
POSTGRES_CHANNEL_BINDING=require

# Stripe secrets
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Kafka credentials (only if your broker requires auth)
KAFKA_USERNAME=your-kafka-username
KAFKA_PASSWORD=your-kafka-password
# Optional private CA material
# KAFKA_CA_CERT_PATH=./certs/ca.pem
# KAFKA_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Optional local overrides (normally provided by Config Service)
# KAFKA_ENABLED=true
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=subscriptions-service
# KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_TOPIC_SUBSCRIPTION_CREATED=SubscriptionCreated
# KAFKA_TOPIC_SUBSCRIPTION_CANCELLED=SubscriptionCancelled
# KAFKA_TOPIC_SUBSCRIPTION_PLAN_CHANGED=SubscriptionPlanChanged
# KAFKA_TOPIC_SUBSCRIPTION_EXPIRED=SubscriptionExpired
# KAFKA_TOPIC_SUBSCRIPTION_UPDATED=SubscriptionUpdated
# STRIPE_CURRENCY=PEN
# STRIPE_PRICE_FREE=price_xxx_free
# STRIPE_PRICE_PLUS=price_xxx_plus
# STRIPE_PRICE_PRO=price_xxx_pro
